rules_version = '2';

// These rules only matter for DIRECT client access to Firestore (e.g. a future
// Flutter mobile app talking to Firestore itself, or the Firebase console).
// The Flask app in this repo uses the Admin SDK, which always bypasses these
// rules -- so the web portal keeps working exactly the same regardless of
// what's set here.
//
// Default posture below: nothing is readable or writable directly from a
// client unless authenticated via Firebase Auth. If/when the companion
// mobile app is built, decide whether it should:
//   (a) talk to Firestore directly (enable narrower rules per-collection), or
//   (b) call the Flask app's routes/JSON endpoints instead (recommended --
//       keeps bill-numbering, stock updates and validation in one place).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Example of what per-collection rules would look like for option (a),
    // once Firebase Auth is wired into the mobile app (left disabled for now):
    //
    // match /items/{itemId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null && request.auth.token.role == 'admin';
    // }
  }
}
